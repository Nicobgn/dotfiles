{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": "    "
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",

    {
      "type": "os",
      "key": "󰍹 OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },

    "break",

    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },

    "break",

    {
      "type": "uptime",
      "key": "󱦟 Uptime"
    }
  ]
}
